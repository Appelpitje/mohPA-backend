{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@mohpa/shared": ["packages/shared/src/index.ts"],
      "@mohpa/shared/*": ["packages/shared/src/*"],
      "@mohpa/db": ["packages/db/src/index.ts"],
      "@mohpa/db/*": ["packages/db/src/*"],
      "@mohpa/api-service": ["packages/api-service/src/index.ts"],
      "@mohpa/api-service/*": ["packages/api-service/src/*"],
      "@mohpa/fesl-engine": ["packages/fesl-engine/src/index.ts"],
      "@mohpa/fesl-engine/*": ["packages/fesl-engine/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
