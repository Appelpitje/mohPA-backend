# mohPA Backend Environment Variables

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://mohpa:mohpa@localhost:5432/mohpa
POSTGRES_USER=mohpa
POSTGRES_PASSWORD=mohpa
POSTGRES_DB=mohpa
POSTGRES_PORT=5432

# Redis Session Store Configuration
REDIS_URL=redis://localhost:6379

# API Service
API_PORT=3000
API_HOST=0.0.0.0
JWT_SECRET=super-secret-mohpa-jwt-key-change-in-production
INTERNAL_API_KEY=mohpa-internal-secret-token
# Cloudflare Turnstile secret — NEVER commit a real value (repo is public).
# Copy this file to gitignored backend/.env on the server.
# Official dummy always-pass secret for local: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# FESL & Theater Ports
FESL_CLIENT_PORT=18270
FESL_SERVER_PORT=18051
THEATER_CLIENT_PORT=18275
THEATER_SERVER_PORT=18056

# Server Host Announcements
PUBLIC_IP=127.0.0.1
THEATER_HOST=127.0.0.1
MESSENGER_HOST=127.0.0.1
