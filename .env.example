# CentralSpy Backend Environment Variables

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://centralspy:centralspy@localhost:5432/centralspy
POSTGRES_USER=centralspy
POSTGRES_PASSWORD=centralspy
POSTGRES_DB=centralspy
POSTGRES_PORT=5432

# Redis Session Store Configuration
REDIS_URL=redis://localhost:6379

# API Service
API_PORT=3000
API_HOST=0.0.0.0
JWT_SECRET=super-secret-centralspy-jwt-key-change-in-production
INTERNAL_API_KEY=centralspy-internal-secret-token

# FESL & Theater Ports
FESL_CLIENT_PORT=18270
FESL_SERVER_PORT=18051
THEATER_CLIENT_PORT=18275
THEATER_SERVER_PORT=18056

# Server Host Announcements
PUBLIC_IP=127.0.0.1
THEATER_HOST=127.0.0.1
MESSENGER_HOST=127.0.0.1
